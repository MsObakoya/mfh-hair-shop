# Public values are safe to use in the browser. Get these from Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Server-side only. Never prefix this with NEXT_PUBLIC_.
MAILGUN_API_KEY=YOUR_MAILGUN_PRIVATE_API_KEY
MAILGUN_DOMAIN=YOUR_VERIFIED_MAILGUN_DOMAIN
MAILGUN_FROM=MFH Hair <orders@YOUR_VERIFIED_MAILGUN_DOMAIN>
